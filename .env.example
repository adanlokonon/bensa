# =========================================
#  BENSA — Variables d'environnement
#  Copier ce fichier en .env avant lancement
# =========================================

# Clé secrète Flask (générer une chaîne aléatoire longue)
SECRET_KEY=change-me-with-a-very-long-random-string

# Environnement (development | production)
FLASK_ENV=development

# Base de données SQLite (chemin relatif au projet)
DATABASE_PATH=instance/bensa.db

# Cloudinary — stockage des CV (créer un compte gratuit sur cloudinary.com)
CLOUDINARY_CLOUD_NAME="CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="CLOUDINARY_API_SECRET"

# Configuration essai gratuit
TRIAL_DURATION_DAYS=14
TRIAL_REMINDER_DAY=12
TRIAL_BLOCK_DAY=15
SUBSCRIPTION_AMOUNT_FCFA=3000

# Contact CODEMASTER
CONTACT_EMAIL=jesukpegosalomon@gmail.com
